{
  "description": "solodev — enforcement the agent cannot forget. See docs/flows/hooks.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-workspace.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
